DATABASE_URL=postgresql+psycopg://opspilot_app:opspilot_app@localhost:5432/opspilot
MIGRATION_DATABASE_URL=postgresql+psycopg://opspilot:opspilot@localhost:5432/opspilot
JWKS_URL=http://localhost:3000/api/auth/jwks
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=http://localhost:3000
CRON_SECRET=change-me

# AI: leave empty to replay the recorded responses in api/fixtures
GEMINI_API_KEY=

# Email: "console" only logs. Use resend or sendgrid for real mail.
DEFAULT_MAIL_PROVIDER=console
RESEND_API_KEY=
SENDGRID_API_KEY=
MAIL_FROM=OpsPilot <no-reply@opspilot.example>

# Production only
# CORS_ORIGINS=["https://your-web-url"]
# PUBLIC_API_URL=https://your-api-url
# STORAGE_SIGNING_SECRET=change-me
